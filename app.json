{
  "expo": {
    "name": "Corpus",
    "slug": "corpus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "corpus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.logesh.corpus"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1210",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.logesh.corpus",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1210",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Corpus uses the camera to read receipts. The photo stays on your phone.",
          "photosPermission": "Corpus reads receipt photos you pick. They stay on your phone.",
          "microphonePermission": false
        }
      ],
      "./plugins/withShareText.js",
      "./plugins/withBankSms.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d9b160b-a1da-49d9-88b6-1c5ab2731e59"
      }
    },
    "owner": "logesh48",
    "backgroundColor": "#F2F2F7"
  }
}
